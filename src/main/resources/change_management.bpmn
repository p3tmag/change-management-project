<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.48.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Proces upravljanja promenama" processRef="changeManagement" />
  </bpmn:collaboration>
  <bpmn:process id="changeManagement" name="Proces upravljanja promenama" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Validate" name="Validator">
        <bpmn:flowNodeRef>notifyCompleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Completed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ValidationResult</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Approver" name="Odobravalac promene">
        <bpmn:flowNodeRef>authorize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AuthorizationDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DevOps" name="DevOps">
        <bpmn:flowNodeRef>peerReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>planImplementation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>backout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ImplementSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Implement</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CCB" name="Odbor za kontrolu promena">
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_CCBMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CCBDecide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CCBDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SMT" name="Tim za upravljanje uslugama">
        <bpmn:flowNodeRef>consultSMT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyBackedOut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SMTReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>preCCBMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_PreCCB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PreCCBDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_BackedOut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FailureDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>initialReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1gi5bku</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Consult</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Requester" name="Podnosilac zahteva">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reviseRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>changeRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registerChange</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_1an9czc</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_Rejected" name="Promena Odbijena">
      <bpmn:incoming>Flow_rejEnd</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateEventDefinition_Rejected" />
    </bpmn:endEvent>
    <bpmn:userTask id="peerReview" name="Tehnicki pregled" camunda:formKey="camunda-forms:/forms/peer_review.form" camunda:candidateGroups="devops">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="authorize" name="Autorizacija promene" camunda:formKey="camunda-forms:/forms/authorize.form" camunda:candidateGroups="approver">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_AuthorizationDecision" name="Autorizacija odobrena?" default="Flow_auth_reject">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_auth_ok</bpmn:outgoing>
      <bpmn:outgoing>Flow_auth_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="notifyRejected" name="Obavesti podnosioca (odbijeno)" camunda:delegateExpression="${notifyRequester}">
      <bpmn:extensionElements>
        <camunda:field name="outcome">
          <camunda:string>rejected</camunda:string>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_join_rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_rejEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="notifyCompleted" name="Obavesti podnosioca (zavrseno)" camunda:delegateExpression="${notifyRequester}">
      <bpmn:extensionElements>
        <camunda:field name="outcome">
          <camunda:string>completed</camunda:string>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_val_ok</bpmn:incoming>
      <bpmn:outgoing>Flow_compEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="consultSMT" name="Konsultacije sa timom za upravljanje uslugama" camunda:formKey="camunda-forms:/forms/consult_smt.form" camunda:candidateGroups="smt">
      <bpmn:incoming>Flow_join_consult</bpmn:incoming>
      <bpmn:outgoing>Flow_consult</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="notifyBackedOut" name="Obavesti podnosioca (odustanak)" camunda:delegateExpression="${notifyRequester}">
      <bpmn:extensionElements>
        <camunda:field name="outcome">
          <camunda:string>backedOut</camunda:string>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_backout</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="reviseRequest" name="Dorada zahteva za promenu" camunda:formKey="camunda-forms:/forms/revise_request.form" camunda:candidateGroups="requester">
      <bpmn:incoming>Flow_smt_rework</bpmn:incoming>
      <bpmn:outgoing>Flow_reworkBack</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_SMTReview" name="Odluka SMT-a" default="Flow_smt_rework">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_smt_proceed</bpmn:outgoing>
      <bpmn:outgoing>Flow_smt_reject</bpmn:outgoing>
      <bpmn:outgoing>Flow_smt_hold</bpmn:outgoing>
      <bpmn:outgoing>Flow_smt_rework</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="preCCBMeeting" name="Pre-CCB sastanak" camunda:formKey="camunda-forms:/forms/pre_ccb.form" camunda:candidateGroups="smt">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${updateChangeStatus}" event="start">
          <camunda:field name="status">
            <camunda:string>PRE_CCB_REVIEW</camunda:string>
          </camunda:field>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_join_preccb</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Join_PreCCB">
      <bpmn:incoming>Flow_smt_proceed</bpmn:incoming>
      <bpmn:incoming>Flow_preccb_hold</bpmn:incoming>
      <bpmn:outgoing>Flow_join_preccb</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_PreCCBDecision" name="Odluka pre-CCB" default="Flow_preccb_hold">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_preccb_proceed</bpmn:outgoing>
      <bpmn:outgoing>Flow_preccb_reject</bpmn:outgoing>
      <bpmn:outgoing>Flow_preccb_hold</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_CCBMeeting">
      <bpmn:incoming>Flow_preccb_proceed</bpmn:incoming>
      <bpmn:incoming>Flow_10_hold</bpmn:incoming>
      <bpmn:outgoing>Flow_7b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CCBDecide" name="CCB Sastanak" camunda:formKey="camunda-forms:/forms/ccb_decision.form" camunda:candidateGroups="ccb">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${updateChangeStatus}" event="start">
          <camunda:field name="status">
            <camunda:string>CCB_REVIEW</camunda:string>
          </camunda:field>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_7b</bpmn:incoming>
      <bpmn:outgoing>Flow_8b</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_CCBDecision" name="CCB Odluka" default="Flow_10_hold">
      <bpmn:incoming>Flow_8b</bpmn:incoming>
      <bpmn:outgoing>Flow_9_approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_10_hold</bpmn:outgoing>
      <bpmn:outgoing>Flow_11_rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="planImplementation" name="Implementacioni plan" camunda:formKey="camunda-forms:/forms/plan_implementation.form" camunda:candidateGroups="devops">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${updateChangeStatus}" event="start">
          <camunda:field name="status">
            <camunda:string>APPROVED</camunda:string>
          </camunda:field>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_9_approved</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="implement" name="Implementacija promene" camunda:formKey="camunda-forms:/forms/implement.form" camunda:candidateGroups="devops">
      <bpmn:incoming>Flow_join_implement</bpmn:incoming>
      <bpmn:outgoing>Flow_16b</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_BackedOut" name="Odustanak od promene">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Completed" name="Promena zavrsena">
      <bpmn:incoming>Flow_compEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="backout" name="Povlacenje promene" camunda:formKey="camunda-forms:/forms/change_info.form" camunda:candidateGroups="devops">
      <bpmn:incoming>Flow_fail_backout</bpmn:incoming>
      <bpmn:outgoing>Flow_backout</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="validate" name="Validacija promene" camunda:formKey="camunda-forms:/forms/validate.form" camunda:candidateGroups="validator">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${updateChangeStatus}" event="start">
          <camunda:field name="status">
            <camunda:string>IMPLEMENTED</camunda:string>
          </camunda:field>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_17_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ImplementSuccess" name="Uspesno?" default="Flow_18_no">
      <bpmn:incoming>Flow_16b</bpmn:incoming>
      <bpmn:outgoing>Flow_17_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_18_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_ValidationResult" name="Validacija uspesna?" default="Flow_val_fail">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_val_ok</bpmn:outgoing>
      <bpmn:outgoing>Flow_val_fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_FailureDecision" name="Odluka o neuspehu" default="Flow_fail_backout">
      <bpmn:incoming>Flow_consult</bpmn:incoming>
      <bpmn:outgoing>Flow_fail_retry</bpmn:outgoing>
      <bpmn:outgoing>Flow_fail_backout</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="initialReview" name="Pregled promene" camunda:formKey="camunda-forms:/forms/smt_review.form" camunda:candidateGroups="smt">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${updateChangeStatus}" event="start">
          <camunda:field name="status">
            <camunda:string>UNDER_REVIEW</camunda:string>
          </camunda:field>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1c6a2ei</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="changeRequest" name="Zahtev za promenu" camunda:formKey="camunda-forms:/forms/change_request.form" camunda:candidateGroups="requester">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_1an9czc</bpmn:incoming>
      <bpmn:outgoing>Flow_0y4kpju</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="registerChange" name="Registracija promene" camunda:delegateExpression="${registerChange}">
      <bpmn:incoming>Flow_0y4kpju</bpmn:incoming>
      <bpmn:outgoing>Flow_reg</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_1gi5bku">
      <bpmn:incoming>Flow_reg</bpmn:incoming>
      <bpmn:incoming>Flow_reworkBack</bpmn:incoming>
      <bpmn:incoming>Flow_smt_hold</bpmn:incoming>
      <bpmn:outgoing>Flow_1c6a2ei</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Rejected">
      <bpmn:incoming>Flow_11_rejected</bpmn:incoming>
      <bpmn:incoming>Flow_smt_reject</bpmn:incoming>
      <bpmn:incoming>Flow_preccb_reject</bpmn:incoming>
      <bpmn:incoming>Flow_auth_reject</bpmn:incoming>
      <bpmn:outgoing>Flow_join_rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Consult">
      <bpmn:incoming>Flow_18_no</bpmn:incoming>
      <bpmn:incoming>Flow_val_fail</bpmn:incoming>
      <bpmn:outgoing>Flow_join_consult</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Implement">
      <bpmn:incoming>Flow_auth_ok</bpmn:incoming>
      <bpmn:incoming>Flow_fail_retry</bpmn:incoming>
      <bpmn:outgoing>Flow_join_implement</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1an9czc" sourceRef="StartEvent_1" targetRef="changeRequest" />
    <bpmn:sequenceFlow id="Flow_rejEnd" sourceRef="notifyRejected" targetRef="EndEvent_Rejected" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="planImplementation" targetRef="peerReview" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="peerReview" targetRef="authorize" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="authorize" targetRef="Gateway_AuthorizationDecision" />
    <bpmn:sequenceFlow id="Flow_auth_ok" name="Odobreno" sourceRef="Gateway_AuthorizationDecision" targetRef="Join_Implement">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${authorizationApproved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_auth_reject" name="Odbijeno" sourceRef="Gateway_AuthorizationDecision" targetRef="Join_Rejected" />
    <bpmn:sequenceFlow id="Flow_join_rejected" sourceRef="Join_Rejected" targetRef="notifyRejected" />
    <bpmn:sequenceFlow id="Flow_val_ok" name="Uspesno" sourceRef="Gateway_ValidationResult" targetRef="notifyCompleted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${validationSuccessful == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_compEnd" sourceRef="notifyCompleted" targetRef="EndEvent_Completed" />
    <bpmn:sequenceFlow id="Flow_join_consult" sourceRef="Join_Consult" targetRef="consultSMT" />
    <bpmn:sequenceFlow id="Flow_consult" sourceRef="consultSMT" targetRef="Gateway_FailureDecision" />
    <bpmn:sequenceFlow id="Flow_backout" sourceRef="backout" targetRef="notifyBackedOut" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="notifyBackedOut" targetRef="EndEvent_BackedOut" />
    <bpmn:sequenceFlow id="Flow_smt_rework" name="Vrati na doradu" sourceRef="Gateway_SMTReview" targetRef="reviseRequest" />
    <bpmn:sequenceFlow id="Flow_reworkBack" name="Zahtev doradjen" sourceRef="reviseRequest" targetRef="Gateway_1gi5bku">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${updateChangeDetails}" event="take" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="initialReview" targetRef="Gateway_SMTReview" />
    <bpmn:sequenceFlow id="Flow_smt_reject" name="Odbijeno" sourceRef="Gateway_SMTReview" targetRef="Join_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${smtDecision == "reject"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_smt_hold" name="Na cekanju" sourceRef="Gateway_SMTReview" targetRef="Gateway_1gi5bku">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${updateChangeStatus}" event="take">
          <camunda:field name="status">
            <camunda:string>ON_HOLD</camunda:string>
          </camunda:field>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${smtDecision == "hold"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_smt_proceed" name="Spremno za pre-CCB" sourceRef="Gateway_SMTReview" targetRef="Join_PreCCB">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${smtDecision == "proceed"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_join_preccb" sourceRef="Join_PreCCB" targetRef="preCCBMeeting" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="preCCBMeeting" targetRef="Gateway_PreCCBDecision" />
    <bpmn:sequenceFlow id="Flow_preccb_hold" name="Na cekanju" sourceRef="Gateway_PreCCBDecision" targetRef="Join_PreCCB">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${updateChangeStatus}" event="take">
          <camunda:field name="status">
            <camunda:string>ON_HOLD</camunda:string>
          </camunda:field>
        </camunda:executionListener>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_preccb_proceed" name="Spremno za CCB" sourceRef="Gateway_PreCCBDecision" targetRef="Join_CCBMeeting">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${preCcbDecision == "proceed"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_preccb_reject" name="Odbijeno" sourceRef="Gateway_PreCCBDecision" targetRef="Join_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${preCcbDecision == "reject"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10_hold" name="Na cekanju" sourceRef="Gateway_CCBDecision" targetRef="Join_CCBMeeting">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${updateChangeStatus}" event="take">
          <camunda:field name="status">
            <camunda:string>ON_HOLD</camunda:string>
          </camunda:field>
        </camunda:executionListener>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7b" sourceRef="Join_CCBMeeting" targetRef="Task_CCBDecide" />
    <bpmn:sequenceFlow id="Flow_8b" sourceRef="Task_CCBDecide" targetRef="Gateway_CCBDecision" />
    <bpmn:sequenceFlow id="Flow_11_rejected" name="Odbijeno" sourceRef="Gateway_CCBDecision" targetRef="Join_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ccbDecision == "rejected"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9_approved" name="Odobreno" sourceRef="Gateway_CCBDecision" targetRef="planImplementation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ccbDecision == "approved"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_join_implement" sourceRef="Join_Implement" targetRef="implement" />
    <bpmn:sequenceFlow id="Flow_16b" sourceRef="implement" targetRef="Gateway_ImplementSuccess" />
    <bpmn:sequenceFlow id="Flow_fail_backout" name="Povuci promenu" sourceRef="Gateway_FailureDecision" targetRef="backout" />
    <bpmn:sequenceFlow id="Flow_17_yes" name="Da" sourceRef="Gateway_ImplementSuccess" targetRef="validate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${implementationSuccessful == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="validate" targetRef="Gateway_ValidationResult" />
    <bpmn:sequenceFlow id="Flow_18_no" name="Ne" sourceRef="Gateway_ImplementSuccess" targetRef="Join_Consult" />
